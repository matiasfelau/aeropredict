# Configuración del backend
DEBUG=false
APP_NAME="AeroPredict Backend"
APP_VERSION="0.1.0"
API_PREFIX="/api"

# Database PostgreSQL
DATABASE_URL=postgresql://aeropredict_user:aeropredict_password@postgres:5432/aeropredict
SQLALCHEMY_POOL_SIZE=20
SQLALCHEMY_MAX_OVERFLOW=40
SQLALCHEMY_POOL_PRE_PING=true

# JWT
SECRET_KEY=your-super-secret-key-change-in-production-please-do-it-now
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]
CORS_ALLOW_CREDENTIALS=true

# Umbrales de negocio
UMBRAL_BAJA_OCUPACION=0.60
UMBRAL_OCUPACION_ELEVADA=0.85
FACTOR_MAX_VALIDO=1.05
CRECIMIENTO_TURISTICO_PCT=0.20
